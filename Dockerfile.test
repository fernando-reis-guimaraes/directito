# syntax=docker/dockerfile:1.4

ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-alpine AS test

RUN npm install --global corepack@latest

RUN apk --no-cache add python3 py3-setuptools build-base git

WORKDIR /directus

COPY package.json .
RUN corepack enable && corepack prepare

RUN chown node:node .
USER node

ENV NODE_OPTIONS=--max-old-space-size=8192

COPY pnpm-lock.yaml .
RUN pnpm fetch

COPY --chown=node:node . .

ARG TEST_MODE=suite
ARG TEST_COMMAND=""

RUN <<'EOF'
	set -eu

	pnpm install --recursive --offline --frozen-lockfile

	has_script() {
		node -e 'const scripts = require("./package.json").scripts || {}; process.exit(scripts[process.argv[1]] ? 0 : 1)' "$1"
	}

	run_required_script() {
		if ! has_script "$1"; then
			echo "Required script not found: $1" >&2
			exit 1
		fi

		echo
		echo ">>> pnpm run $1"
		pnpm run "$1"
	}

	run_optional_script() {
		if has_script "$1"; then
			echo
			echo ">>> pnpm run $1"
			pnpm run "$1"
		else
			echo "Skipping missing script: $1"
		fi
	}

	run_normal_tests() {
		echo
		echo ">>> pnpm --recursive --filter '!tests-blackbox' --filter '!e2e' test"
		pnpm --recursive --filter '!tests-blackbox' --filter '!e2e' test
	}

	run_coverage_tests() {
		echo
		echo ">>> pnpm --recursive --filter '!tests-blackbox' --filter '!e2e' test:coverage"
		pnpm --recursive --filter '!tests-blackbox' --filter '!e2e' test:coverage
	}

	build_once() {
		if [ "${DID_BUILD:-false}" = "true" ]; then
			return
		fi

		run_required_script build
		DID_BUILD="true"
	}

	if [ -n "${TEST_COMMAND}" ]; then
		echo
		echo ">>> ${TEST_COMMAND}"
		sh -lc "${TEST_COMMAND}"
		exit 0
	fi

	case "${TEST_MODE}" in
		lint)
			run_required_script lint
			;;
		style)
			run_required_script lint:style
			;;
		format)
			run_required_script format
			;;
		unit|test)
			build_once
			run_normal_tests
			;;
		blackbox)
			run_required_script test:blackbox
			;;
		coverage)
			build_once
			run_coverage_tests
			;;
		suite)
			run_optional_script format
			run_required_script lint
			run_optional_script lint:style
			build_once
			run_normal_tests
			;;
		all)
			run_optional_script format
			run_required_script lint
			run_optional_script lint:style
			build_once
			run_normal_tests
			run_optional_script test:blackbox
			run_coverage_tests
			;;
		*)
			echo "Unknown TEST_MODE: ${TEST_MODE}" >&2
			echo "Allowed: lint, style, format, unit, test, blackbox, coverage, suite, all" >&2
			exit 1
			;;
	esac
EOF
